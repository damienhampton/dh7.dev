---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);
---
<Base title="Damien Hampton — Software Engineer">

  <section class="mb-16">
    <p class="text-xl leading-relaxed text-[#2A2520] max-w-lg">
      Hi, I'm Damien 👋. I'm a software engineer and engineering leader with over 25 years of experience.
    </p>
    <p class="mt-4 text-xl leading-relaxed text-[#2A2520] max-w-lg">
      This is where I write about software development, integrations between business systems, and the changing shape of engineering work.
      More <a href="/about" class="text-[#A87820] hover:underline">about me</a>.
    </p>
  </section>

  <section>
    <h2 class="font-[family-name:var(--font-sans)] text-xs font-500 uppercase tracking-widest text-[#7A7068] mb-6">📖 Recent writing</h2>
    <ul class="divide-y divide-[#E6DFD0]">
      {posts.map(post => (
        <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
          <a href={`/blog/${post.id}`} class="font-[family-name:var(--font-sans)] font-400 text-[#2A2520] hover:text-[#A87820] transition-colors no-underline">
            {post.data.title}
          </a>
          <time datetime={post.data.publishedAt.toISOString()} class="font-[family-name:var(--font-sans)] text-sm text-[#7A7068] sm:whitespace-nowrap sm:shrink-0">
            {post.data.publishedAt.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })}
          </time>
        </li>
      ))}
    </ul>
    <div class="mt-8">
      <a href="/blog" class="font-[family-name:var(--font-sans)] text-sm text-[#A87820] hover:underline">All posts →</a>
    </div>
  </section>

</Base>
