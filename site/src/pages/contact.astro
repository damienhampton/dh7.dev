---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — DH7" description="Get in touch with Damien Hampton.">

  <div class="max-w-lg">
    <h1 class="font-[family-name:var(--font-sans)] text-3xl font-600 tracking-tight text-[#2A2520] mb-4">✉️ Contact</h1>
    <p class="leading-relaxed text-[#7A7068] mb-4">
      A question about something I've written, a correction, or anything else — feel free to reach out.
    </p>
    <p class="leading-relaxed text-[#7A7068] mb-10">
      For software development services, visit <a href="https://www.26brains.com" class="text-[#A87820] hover:underline">www.26brains.com</a>.
    </p>

    <form action="https://formspree.io/f/mdovyqog" method="POST" class="space-y-6">
      <input type="hidden" name="_subject" value="dh7.dev message" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="name" class="font-[family-name:var(--font-sans)] text-sm font-500 text-[#2A2520] block mb-2">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-3 border border-[#E6DFD0] rounded-none bg-white text-[#2A2520] font-[family-name:var(--font-sans)] text-sm focus:outline-none focus:border-[#A87820] transition-colors"
        />
      </div>

      <div>
        <label for="email" class="font-[family-name:var(--font-sans)] text-sm font-500 text-[#2A2520] block mb-2">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 border border-[#E6DFD0] rounded-none bg-white text-[#2A2520] font-[family-name:var(--font-sans)] text-sm focus:outline-none focus:border-[#A87820] transition-colors"
        />
      </div>

      <div>
        <label for="message" class="font-[family-name:var(--font-sans)] text-sm font-500 text-[#2A2520] block mb-2">Message</label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="w-full px-4 py-3 border border-[#E6DFD0] rounded-none bg-white text-[#2A2520] font-[family-name:var(--font-sans)] text-sm focus:outline-none focus:border-[#A87820] transition-colors resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="font-[family-name:var(--font-sans)] text-sm font-500 bg-[#2A2520] text-[#FDFBF4] px-6 py-3 hover:bg-[#A87820] transition-colors cursor-pointer border-0"
      >
        Send message
      </button>
      <p id="contact-error" class="font-[family-name:var(--font-sans)] text-sm text-[#B42318]" role="alert" hidden></p>
    </form>
  </div>

  <script>
    // Formspree's free plan ignores _next, so submit via fetch and redirect ourselves.
    // Without JS the form still posts normally and lands on Formspree's own thanks page.
    const form = document.querySelector<HTMLFormElement>('form[action*="formspree.io"]');
    const error = document.getElementById('contact-error');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || !error) return;
      error.hidden = true;
      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
        window.location.href = '/thanks';
      } catch {
        error.textContent = 'Sorry, the message could not be sent. Please try again in a moment.';
        error.hidden = false;
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  </script>

</Base>
